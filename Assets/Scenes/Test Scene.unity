MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1505284615}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b1194c0fad10c974d8394a09968b93a4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogue:
    dialogueLines:
    - character:
        name: Orson
        icon: {fileID: 21300000, guid: 978dbdacd167b58428f04e7d4b43707a, type: 3}
        clip: {fileID: 8300000, guid: 0ba7dad396de6e743ba246afe6343a3e, type: 3}
      line: Pac-Man, my readings suggest a nearby ghost to rescue! Either that, or
        I have spaghetti sauce on my monitor...
    - character:
        name: Pac-Man
        icon: {fileID: 21300000, guid: 3f5f83a1bf2a68345af8549e35da621f, type: 3}
        clip: {fileID: 8300000, guid: f411289e816eb0249b1b93072445cd69, type: 3}
      line: Great, so you couldn't just port me straight to it, could ya? OH no,
        it's MUCH more fun to see poor Pac-Man bounced around like a big yellow ball!
    - character:
        name: Orson
        icon: {fileID: 21300000, guid: 978dbdacd167b58428f04e7d4b43707a, type: 3}
        clip: {fileID: 8300000, guid: 8667ea09bf5b9e045a1841287fe32cad, type: 3}
      line: Sorry, Pac-Man. I'll give the teleporter a bit of a tweak. Now, track
        down that ghost for me!
