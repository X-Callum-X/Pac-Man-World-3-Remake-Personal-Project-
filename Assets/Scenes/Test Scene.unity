  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogue:
    dialogueLines:
    - character:
        name: Pac-Man
        icon: {fileID: 21300000, guid: 3f5f83a1bf2a68345af8549e35da621f, type: 3}
        clip: {fileID: 8300000, guid: 35cc1bb72c7994d49b4601fe685c8363, type: 3}
      line: Orson, why am I here?
    - character:
        name: Orson
        icon: {fileID: 21300000, guid: 978dbdacd167b58428f04e7d4b43707a, type: 3}
        clip: {fileID: 8300000, guid: 8027629059a9e414c94d29993ae8edb0, type: 3}
      line: Would you believe me if I said the whole world was in danger?
    - character:
        name: Pac-Man
        icon: {fileID: 21300000, guid: 3f5f83a1bf2a68345af8549e35da621f, type: 3}
        clip: {fileID: 8300000, guid: 8ac7acac287902541b384f05551c0911, type: 3}
      line: Let me get back to you on that, buddy...
