  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b1194c0fad10c974d8394a09968b93a4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogue:
    dialogueLines:
    - character:
        name: Pinky
        icon: {fileID: 21300000, guid: fb4b69af974b3054ba3e96a88db058be, type: 3}
        clip: {fileID: 8300000, guid: 65fc9c181a3848e4985c3aeb3a224a3d, type: 3}
      line: Hiya, Pac-Man! If we're gonna beat this Erwin guy, you're gonna need
        all the help you can get!
    - character:
        name: Pac-Man
        icon: {fileID: 21300000, guid: 3f5f83a1bf2a68345af8549e35da621f, type: 3}
        clip: {fileID: 8300000, guid: fe3b96c6bb615c840b712f088c1acd97, type: 3}
      line: Okaaayyyy...
    - character:
        name: Pinky
        icon: {fileID: 21300000, guid: fb4b69af974b3054ba3e96a88db058be, type: 3}
        clip: {fileID: 8300000, guid: 88317304f9fe4ea42b581c2303bb39a1, type: 3}
      line: 'I can see things you can''t: spectral things, including platforms. And
        if I''m charged up at a Spectral Fountain, I can make those platforms solid
        enough even for you!'
