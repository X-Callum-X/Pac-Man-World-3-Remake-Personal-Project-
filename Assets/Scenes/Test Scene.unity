  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b1194c0fad10c974d8394a09968b93a4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogue:
    dialogueLines:
    - character:
        name: Orson
        icon: {fileID: 21300000, guid: 978dbdacd167b58428f04e7d4b43707a, type: 3}
        clip: {fileID: 8300000, guid: bca3cfeac6a5c6e4a934a0ef779fd508, type: 3}
      line: Thinking of the Spectral Realm has made me nostalgic... I remember paddling
        in the miasma seas as a little ghost... Making fog-castles and searching
        smoke pools for pappie mites... Ho ho, happy times!
