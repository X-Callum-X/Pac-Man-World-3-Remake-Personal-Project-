--- !u!114 &573526015
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 573526013}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b1194c0fad10c974d8394a09968b93a4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogue:
    dialogueLines:
    - character:
        name: Pac-Man
        icon: {fileID: 21300000, guid: 3f5f83a1bf2a68345af8549e35da621f, type: 3}
        clip: {fileID: 8300000, guid: 29c67430f5621d04d84e7efed79f45ba, type: 3}
      line: 'Ors? You say that this "Erwin" guy is messing with the Spectral Realm?
        No wonder the Spectral dudes are upset... Not only are they outcasts themselves,
        but now their HOME isn''t even their own! '
    - character:
        name: Orson
        icon: {fileID: 21300000, guid: 978dbdacd167b58428f04e7d4b43707a, type: 3}
        clip: {fileID: 8300000, guid: 4ef868e6ba9b90e40a12fdc7b7d075ff, type: 3}
      line: Yesss, but they're vicious little creeps anyway, so don't feel TOO sorry
        for them.
