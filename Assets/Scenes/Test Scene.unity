        clip: {fileID: 8300000, guid: a25c123a01b789042b2fd5b2d0de32d8, type: 3}
      line: Hmmm... This brings back memories!
    - character:
        name: Orson
        icon: {fileID: 21300000, guid: 978dbdacd167b58428f04e7d4b43707a, type: 3}
        clip: {fileID: 8300000, guid: 6d0a09103f878f4419badf9ec239ec4b, type: 3}
      line: Nasty spooks at 3:00, Pac-Man!
    - character:
        name: Pac-Man
        icon: {fileID: 21300000, guid: 3f5f83a1bf2a68345af8549e35da621f, type: 3}
        clip: {fileID: 8300000, guid: 7733666592384fb4996ff19307ccc7c4, type: 3}
      line: Ah, then I've got plenty of time to... OHH!
