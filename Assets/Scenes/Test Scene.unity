  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b1194c0fad10c974d8394a09968b93a4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogue:
    dialogueLines:
    - character:
        name: Pac-Man
        icon: {fileID: 21300000, guid: 3f5f83a1bf2a68345af8549e35da621f, type: 3}
        clip: {fileID: 8300000, guid: 852d40154091879429ae83ebd385116b, type: 3}
      line: Orson, who made these robots?
    - character:
        name: Orson
        icon: {fileID: 21300000, guid: 978dbdacd167b58428f04e7d4b43707a, type: 3}
        clip: {fileID: 8300000, guid: 89a004e316fc61b49be912b34eaa9aa8, type: 3}
      line: 'A nasty creep named Erwin. Typical megalomaniac: Hates chocolates and
        kittens. Haha, an only child, I think. '
    - character:
        name: Pac-Man
        icon: {fileID: 21300000, guid: 3f5f83a1bf2a68345af8549e35da621f, type: 3}
        clip: {fileID: 8300000, guid: ba7da02707862b240ad0b6e3d19ee3ff, type: 3}
      line: I know the type. Well, at least I can get across the goo now!
